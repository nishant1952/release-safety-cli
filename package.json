    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "7.0.2",
    "vite": "7.1.5"
  }
}
